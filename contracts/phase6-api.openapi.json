{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenHire Phase 6 AI API",
    "version": "1.0.0",
    "description": "Local-model AI, talent and integrity. Staff routes use the BFF session plus CSRF header, or a service JWT. Public routes use an application receipt. /internal routes use the shared service secret and are never routed by the public gateway. AI output is always a recommendation, draft or signal; people make every consequential decision."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    },
    {
      "BffSession": [],
      "CsrfHeader": []
    }
  ],
  "paths": {
    "/jobs/ai-draft": {
      "post": {
        "operationId": "draftJobWithAi",
        "summary": "AI job description, rubric, knockouts and interview plan; creates nothing",
        "responses": {
          "200": {
            "description": "Success"
          },
          "202": {
            "description": "Accepted (long-running evaluation)"
          },
          "204": {
            "description": "Done"
          },
          "400": {
            "description": "Invalid input; settings errors carry errors[{field,message}]"
          },
          "401": {
            "description": "Authentication required"
          },
          "402": {
            "description": "AI_BUDGET_EXHAUSTED"
          },
          "403": {
            "description": "Wrong role or tenant, or an invalid receipt"
          },
          "404": {
            "description": "Unknown or inaccessible record"
          },
          "409": {
            "description": "Conflicting state, cooldown, or PROMOTION_BLOCKED"
          },
          "503": {
            "description": "AI_UNAVAILABLE: the model is unreachable or its output could not be made valid; callers fall back"
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },

{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenHire Phase 3 UI API",
    "version": "1.0.0",
    "description": "Staff routes use BFF session plus CSRF header, or service JWT. Public receipt routes do not use ambient session authority. Internal shared-secret endpoints are documented in service Markdown and are not gateway routes."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    },
    {
      "BffSession": [],
      "CsrfHeader": []
    }
  ],
  "paths": {
    "/applications": {
      "post": {
        "operationId": "submitApplication",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful result; asynchronous processing can still be pending"
          },
          "400": {
            "description": "Invalid input or missing consent"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Wrong role, tenant, agency assignment, or receipt"
          },
          "404": {
            "description": "Unknown or inaccessible record"
          },
          "409": {
            "description": "Changed idempotency payload, state, or concurrent update conflict"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jobId",
                  "name",
                  "email",
                  "processingConsent",
                  "consentVersion"
                ],
                "properties": {
                  "jobId": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "processingConsent": {
                    "type": "boolean",
                    "const": true
                  },
                  "consentVersion": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "RECRUITER",
                      "AGENCY",
                      "REFERRAL",
                      "INTERNAL",
                      "PUBLIC_API"
                    ]
                  },
                  "owner": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "externalReference": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "answers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "jobId",
                  "name",
                  "email",
                  "processingConsent",
                  "consentVersion"
                ],
                "properties": {
                  "jobId": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "processingConsent": {
                    "type": "string",
                    "enum": [
                      "true"
                    ]
                  },
                  "consentVersion": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "RECRUITER",
                      "AGENCY",
                      "REFERRAL",
                      "INTERNAL",
                      "PUBLIC_API"
                    ]
                  },
                  "owner": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "externalReference": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "answers": {
                    "type": "string",
                    "description": "JSON object of question ID to answer"
                  },
                  "resume": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listApplications",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,

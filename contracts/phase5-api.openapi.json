{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenHire Phase 5 UI API",
    "version": "1.0.0",
    "description": "Offers, hire saga and employee workflows. Staff routes use BFF session plus CSRF header, or service JWT. Public routes authenticate with a signed offer token or an application receipt, never an ambient session. Errors are RFC 9457 problem details."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    },
    {
      "BffSession": [],
      "CsrfHeader": []
    }
  ],
  "paths": {
    "/offers": {
      "get": {
        "operationId": "listOffers",
        "summary": "Offers for the tenant, optionally filtered by status",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or a rule was not met"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Wrong role or tenant, or an invalid receipt"
          },
          "404": {
            "description": "Unknown or inaccessible record"
          },
          "409": {
            "description": "Conflicting state: wrong stage, not approved, already decided, or no longer open"
          }
        }
      }
    },
